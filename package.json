{
  "name": "@mgomez-ext/mrs-ui",
  "version": "1.1.0",
  "description": "A cromprehensive design system Based on Material UI, with 53 production ready React components and TypeScript support...",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/mrs-ui.css",
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/lazy.mjs",
      "require": "./dist/lazy.js"
    },
    "./theme": {
      "types": "./dist/theme/theme.d.ts",
      "import": "./dist/theme/theme.mjs",
      "require": "./dist/theme/theme.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.mjs",
      "require": "./dist/dashboard/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "npm run tokens:build && vite build",
    "build-storybook": "npm run tokens:build && storybook build",
    "deploy-storybook": "npm run build-storybook && gh-pages -d storybook-static",
    "test": "jest",
    "test:clean": "jest --clearCache && jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --ignore-pattern 'src/tokens/scripts/**' --ignore-pattern '**/*.mdx'",
    "lint:fix": "eslint src --ext .ts,.tsx --ignore-pattern 'src/tokens/scripts/**' --ignore-pattern '**/*.mdx' --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run lint && npm run type-check && npm test && npm run build",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish",
    "tokens:build": "style-dictionary build --config src/tokens/config/style-dictionary.config.js",
    "tokens:clean": "rimraf src/tokens/generated/*",
    "tokens:rebuild": "npm run tokens:clean && npm run tokens:build",
    "tokens:watch": "nodemon --watch src/tokens/source -e json --exec npm run tokens:build",
    "tokens:sync:pull": "node src/tokens/scripts/sync-figma-tokens.js --direction=pull",
    "tokens:sync:push": "node src/tokens/scripts/sync-figma-tokens.js --direction=push",
    "tokens:sync:dry-run": "node src/tokens/scripts/sync-figma-tokens.js --direction=pull --dry-run",
    "chromatic": "dotenv -e .env.local -e .env -- npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN"
  },
  "keywords": [
    "design-system",
    "material-ui",
    "mui",
    "react",
    "components",
    "ui",
    "typescript",
    "storybook",
    "design-tokens",
    "accessible",
    "responsive",
    "ui-library",
    "theme"
  ],
  "author": "MRS Design System Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgomez-ext/mrs-ui.git"
  },
  "bugs": {
    "url": "https://github.com/mgomez-ext/mrs-ui/issues"
  },
  "homepage": "https://github.com/mgomez-ext/mrs-ui#readme",
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@storybook/addon-a11y": "^10.2.3",
    "@storybook/addon-docs": "^10.2.3",
    "@storybook/addon-themes": "^10.2.3",
    "@storybook/addon-vitest": "^10.2.3",
    "@storybook/react-vite": "^10.2.3",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.38",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "chromatic": "^13.3.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "gh-pages": "^6.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.1.0",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "react-router-dom": "^7.13.0",
    "rimraf": "^6.0.1",
    "storybook": "^10.2.3",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "undici": "^6.23.0",
    "lodash": "^4.17.21",
    "test-exclude": "^7.0.1"
  },
  "dependencies": {
    "@mui/x-date-pickers": "^8.23.0",
    "dayjs": "^1.11.19"
  }
}
